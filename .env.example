# Motion MCP configuration. Copy to .env and fill in. Never commit .env.
# Full reference: packages/shared/src/config.ts

NODE_ENV=development
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787
ALLOWED_HOSTS=localhost,127.0.0.1,app.motion.digitop.ai
DATA_DIR=.data

# Comma-separated bearer keys accepted by /mcp (e.g. mmcp_xxx). Empty = no auth in development only.
MOTION_API_KEYS=

# Models (all via OpenRouter). Model ids are config, not code.
OPENROUTER_API_KEY=
DIRECTOR_MODEL=anthropic/claude-opus-5.5
CODER_MODEL=deepseek/deepseek-v4-flash
DECISION_MODEL=deepseek/deepseek-v4-flash
VISION_MODEL=google/gemini-3.1-flash-lite

# Jev decision layer via TypeSafe (optional; falls back to OpenRouter, then rules)
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest

# host-opus | internal-opus | custom
DEFAULT_DIRECTOR_MODE=internal-opus
# deterministic | pi | auto
IMPLEMENTATION_MODE=auto
MAX_REVISION_LOOPS=2
# Concurrent compile/render jobs per process
JOB_CONCURRENCY=1
# Early-access credits granted once per new workspace (1 credit = $0.01)
TRIAL_CREDITS=500
# HMAC secret for signed /artifacts URLs (derived from MOTION_API_KEYS when empty)
ARTIFACT_SIGNING_SECRET=

# Storage: local | r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

DATABASE_URL=

# Billing (Polar.sh)
POLAR_ENVIRONMENT=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=

# Binaries (optional overrides)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Deploy only
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_TOKEN=
